generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file::memory:?cache=shared"
}

enum Role {
  VISITOR
  USER
  ADMIN
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("USER")
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Destination {
  id          String     @id @default(uuid())
  title       String
  description String
  latitude    Float
  longitude   Float
  coverImage  String
  modelUrl    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  landmarks   Landmark[]
}

model Landmark {
  id            String      @id @default(uuid())
  destinationId String
  title         String
  description   String
  latitude      Float
  longitude     Float
  modelUrl      String?
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
